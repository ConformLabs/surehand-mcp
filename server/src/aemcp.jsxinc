        for (var d = 0; d < ie.length; d++) { kf.easeIn.push({ speed: A.round(ie[d].speed), influence: A.round(ie[d].influence) }); kf.easeOut.push({ speed: A.round(oe[d].speed), influence: A.round(oe[d].influence) }); }
