      try { kf.inInterpolation = A.enumName(KeyframeInterpolationType, p.keyInInterpolationType(k)); kf.outInterpolation = A.enumName(KeyframeInterpolationType, p.keyOutInterpolationType(k)); } catch (e) {}
      try {
