      var oa = [], ob = [];
      for (var x = 0; x < ca.order.length; x++) if (cb.layers[ca.order[x]]) oa.push(ca.order[x]);
      for (var y = 0; y < cb.order.length; y++) if (ca.layers[cb.order[y]]) ob.push(cb.order[y]);
