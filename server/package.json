{
  "name": "ae-mcp",
  "version": "1.3.0",
  "description": "MCP server for Adobe After Effects: run ExtendScript and control AE from Claude, ChatGPT and other MCP clients",
  "type": "module",
  "bin": {
    "ae-mcp": "dist/ae-mcp.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/ae-mcp.mjs",
    "package": "node scripts/package.mjs",
    "sign": "node scripts/sign-extension.mjs",
    "check": "tsc --noEmit && vitest run && node build.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@babel/standalone": "^8.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronyitzhaki/after-effects-mcp.git"
  },
  "homepage": "https://github.com/ronyitzhaki/after-effects-mcp",
  "author": "Rony Itzhaki"
}
