{
  "name": "surehand-mcp",
  "version": "1.4.0-beta.4",
  "description": "Surehand MCP for Adobe After Effects: run ExtendScript and control AE from Claude, ChatGPT and other MCP clients",
  "type": "module",
  "bin": {
    "surehand-ae": "dist/surehand-ae.mjs",
    "ae-mcp": "dist/surehand-ae.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/surehand-ae.mjs",
    "package": "node scripts/package.mjs",
    "package:mac-pkg": "node scripts/package-mac-pkg.mjs",
    "package:win-installer": "node scripts/package-win-installer.mjs",
    "sign": "node scripts/sign-extension.mjs",
    "test:mac": "node scripts/test-mac.mjs",
    "test:windows": "node scripts/test-windows.mjs",
    "revision-matrix": "node scripts/revision-matrix.mjs",
    "release": "node scripts/release.mjs",
    "check": "tsc --noEmit && vitest run && node build.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@babel/standalone": "^8.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConformLabs/surehand-mcp.git"
  },
  "homepage": "https://github.com/ConformLabs/surehand-mcp",
  "author": "Ron Yitzhaki"
}
