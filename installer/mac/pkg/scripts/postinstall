#!/bin/bash
# Surehand MCP installer package: runs after the payload (~/.surehand/node/bin/node, ~/.surehand/ae/server/surehand-ae.mjs)
# is in place. Hands over to the server's own installer ("surehand-ae install --clients none"), which moves a 1.3
# installation (~/.aemcp) to ~/.surehand/ae, installs the After Effects extension and writes ~/.surehand/ae/config.json.
# The AI apps the user ticked on Installation Type are connected by their own packages after this one (scripts/step,
# installer/ai-apps.mjs); the last one writes the summary at the top of ~/.surehand/ae/install.log.
# Never fails the package: problems go to the log, and re-running the install later is safe.
. "$(dirname "$0")/common.sh"

# the log keeps the last installs only (about 256 KB)
if [ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -gt 262144 ]; then
  tail -c 196608 "$LOG" >"$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG"
fi
{
  echo "=== Surehand MCP package install: $(date '+%Y-%m-%d %H:%M:%S %z') ==="
  echo "user: $(id -un) ($(id -u))  home: $TARGET_HOME  install location: ${DEST:-?}"
  echo "macOS $(sw_vers -productVersion 2>/dev/null) $(uname -m)"
  ls -ln "$NODE" "$SERVER"
} >>"$LOG" 2>&1

if [ ! -x "$NODE" ] || [ ! -f "$SERVER" ]; then
  echo "ERROR: payload missing ($NODE or $SERVER). Nothing else was changed." >>"$LOG"
  exit 0
fi

run_server 180 install --clients none
STATUS=$?
echo "surehand-ae install exited with status $STATUS" >>"$LOG"
[ "$STATUS" = "0" ] || echo "Something did not finish; see above. Re-running the install later is safe." >>"$LOG"
exit 0
