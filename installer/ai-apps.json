{
  "$comment": "The AI apps Surehand MCP connects to: one list for the server (names), the Windows Setup's Choose AI apps page and the Mac Installer's Installation Type choices (installer/ai-apps.mjs), in this order. id: the server's client id (surehand-ae connect <id>). mac: where the Mac Installer looks for the app (~ is the home folder); the server's own test (server/src/cli/clients.ts clientInstalled) is what Windows uses. web: ChatGPT on the web, which needs cloudflared (optional, never ticked by default).",
  "apps": [
    {
      "id": "claude-desktop",
      "name": "Claude Desktop",
      "mac": ["~/Library/Application Support/Claude"]
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "mac": ["~/.claude.json", "~/.local/bin/claude", "~/.claude/local/claude", "/opt/homebrew/bin/claude", "/usr/local/bin/claude"]
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "mac": ["~/.cursor"]
    },
    {
      "id": "codex",
      "name": "ChatGPT desktop / Codex",
      "mac": ["~/.codex", "/Applications/ChatGPT.app", "/Applications/Codex.app", "~/Applications/ChatGPT.app", "/opt/homebrew/bin/codex", "/usr/local/bin/codex"]
    },
    {
      "id": "vscode",
      "name": "VS Code",
      "mac": ["~/Library/Application Support/Code", "/Applications/Visual Studio Code.app", "~/Applications/Visual Studio Code.app"]
    },
    {
      "id": "windsurf",
      "name": "Windsurf / Devin Desktop",
      "mac": ["~/.codeium/windsurf", "~/.config/devin", "~/Library/Application Support/Windsurf", "/Applications/Windsurf.app", "/Applications/Devin.app", "~/Applications/Windsurf.app", "~/Applications/Devin.app"]
    },
    {
      "id": "lm-studio",
      "name": "LM Studio",
      "mac": ["~/.lmstudio", "/Applications/LM Studio.app", "~/Applications/LM Studio.app"]
    }
  ],
  "web": {
    "id": "chatgpt-web",
    "name": "ChatGPT (web)",
    "title": "Set up ChatGPT on the web",
    "default": false
  }
}
